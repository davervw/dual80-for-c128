     9                          
    10                          ; Description
    11                          ; 
    12                          ; demo to extend VDC 80 columns across VIC-II (left) and VDC (right)
    13                          ; making for a wider 80 column screen -- extending the screen across both monitors
    14                          ;
    15                          ; Design
    16                          ;
    17                          ; * initializes VDC to 40 column mode, skipping 40 characters so is right side
    18                          ; * sets up IRQ
    19                          ; * new irq copies next 5 lines x 40 columns from VDC RAM to VIC-II screen
    20                          ;   and inverts on VIC-II screen where VDC cursor is pointing
    21                          ;
    22                          ; Status = ALPHA, demonstrable, testable but known bugs/limitations
    23                          
    24                          vdc_register = $d600
    25                          vdc_value    = $d601
    26                          
    27                          * = $1300 ; fits in an available RAM block on C128
    28                          ; recommended to configure using with BOOT sector (e.g. see 1571 demo disk)
    29                          
    30                          start_80dual: ;--------------------------------------------------------------
    31  1300 a000                   ldy #$00
    32  1302 bec515             --  ldx vdc_init,y
    33  1305 3012                   bmi +
    34  1307 b9c615                 lda vdc_init+1,y
    35  130a 8e00d6                 stx vdc_register
    36  130d 2c00d6             -   bit vdc_register
    37  1310 10fb                   bpl -
    38  1312 8d01d6                 sta vdc_value
    39  1315 c8                     iny
    40  1316 c8                     iny
    41  1317 d0e9                   bne --
    42  1319 a900               +   lda #$00
    43  131b 8ddb15                 sta linenum
    44  131e 78                     sei
    45  131f a9db                   lda #<newirq
    46  1321 a213                   ldx #>newirq
    47  1323 8d1403                 sta $0314 ; irq vector low
    48  1326 8e1503                 stx $0315 ; irq vector high
    49  1329 58                     cli
    50  132a 4c8c14                 jmp display_credit
    51                          
    52                          read_line: ;-----------------------------------------------------------------
    53  132d b99c15                 lda mult80high,y
    54  1330 a212                   ldx #$12
    55  1332 8e00d6                 stx vdc_register
    56  1335 2c00d6             -   bit vdc_register
    57  1338 10fb                   bpl -
    58  133a 8d01d6                 sta vdc_value
    59  133d b98315                 lda mult80low,y
    60  1340 a213                   ldx #$13
    61  1342 8e00d6                 stx vdc_register
    62  1345 2c00d6             -   bit vdc_register
    63  1348 10fb                   bpl -
    64  134a 8d01d6                 sta vdc_value
    65  134d 98                     tya
    66  134e 48                     pha
    67  134f a000                   ldy #$00
    68  1351 a21f                   ldx #$1f
    69  1353 8e00d6             --  stx vdc_register
    70  1356 2c00d6             -   bit vdc_register
    71  1359 10fb                   bpl -
    72  135b ad01d6                 lda vdc_value
    73  135e 990115                 sta screen_line,y
    74  1361 c8                     iny
    75  1362 c028                   cpy #40 ; for 40 characters
    76  1364 90ed                   bcc -- ; repeat
    77  1366 68                     pla
    78  1367 48                     pha
    79  1368 a8                     tay
    80  1369 18                     clc
    81  136a b99c15                 lda mult80high,y
    82  136d 6908                   adc #$08
    83  136f a212                   ldx #$12
    84  1371 8e00d6                 stx vdc_register
    85  1374 2c00d6             -   bit vdc_register
    86  1377 10fb                   bpl -
    87  1379 8d01d6                 sta vdc_value
    88  137c b98315                 lda mult80low,y
    89  137f a213                   ldx #$13
    90  1381 8e00d6                 stx vdc_register
    91  1384 2c00d6             -   bit vdc_register
    92  1387 10fb                   bpl -
    93  1389 8d01d6                 sta vdc_value
    94  138c a000                   ldy #$00
    95  138e a21f                   ldx #$1f
    96  1390 8e00d6             --  stx vdc_register
    97  1393 2c00d6             -   bit vdc_register
    98  1396 10fb                   bpl -
    99  1398 ad01d6                 lda vdc_value
   100  139b 992915                 sta attrs_line,y
   101  139e c8                     iny
   102  139f c028                   cpy #40 ; for 40 characters
   103  13a1 90ed                   bcc -- ; repeat
   104  13a3 68                     pla
   105  13a4 a8                     tay
   106  13a5 60                     rts
   107                          
   108                          write_line: ;----------------------------------------------------------------
   109  13a6 98                     tya ; save y - line number
   110  13a7 48                     pha
   111  13a8 a904                   lda #$04 ; default vicii screen page
   112  13aa 18                     clc
   113  13ab 796a15                 adc mult40high,y
   114  13ae 8dc613                 sta store_screen+2 ; self-modifying code
   115  13b1 69d4                   adc #$d4 ; add more to get to color RAM page
   116  13b3 8dd213                 sta store_color+2 ; self-modifying code
   117  13b6 b95115                 lda mult40low,y
   118  13b9 8dc513                 sta store_screen+1 ; self-modifying code
   119  13bc 8dd113                 sta store_color+1 ; self-modifying code
   120  13bf a200                   ldx #$00
   121  13c1 bd0115             -   lda screen_line,x
   122  13c4 9d0004             store_screen: sta $0400,x ; vicii screen memory (address self-modified)
   123  13c7 bd2915                 lda attrs_line,x
   124  13ca 290f                   and #15
   125  13cc a8                     tay
   126  13cd b9b515                 lda vdc_to_vicii_color,y
   127  13d0 9d00d8             store_color: sta $d800,x ; vicii color memory (address self-modified)
   128  13d3 e8                     inx
   129  13d4 e028                   cpx #40 ; for 40 characters
   130  13d6 90e9                   bcc - ; repeat
   131  13d8 68                     pla
   132  13d9 a8                     tay ; restore y - line number
   133  13da 60                     rts
   134                          
   135                          newirq: ;--------------------------------------------------------------------
   136                              ; check if rom is busy with vdc from avoid_pages lookup table
   137  13db bd0701                 lda $0107,x ; get high byte irq return address off stack
   138  13de a20f                   ldx #$0f ; point to last one => length(avoid_pages)-1
   139  13e0 ddf114             -   cmp avoid_pages,x
   140  13e3 f057                   beq exit_irq_halfway
   141  13e5 b003                   bcs +
   142  13e7 ca                     dex
   143  13e8 10f6                   bpl - ; repeat 
   144                          
   145                              ; copy 5 lines from VDC to VIC on each IRQ
   146  13ea acdb15             +   ldy linenum
   147  13ed c015                   cpy #$15
   148  13ef 9002                   bcc +
   149  13f1 a000                   ldy #$00
   150  13f3 18                 +   clc
   151  13f4 98                     tya
   152  13f5 6905                   adc #$05
   153  13f7 8d0214                 sta compare_line_count+1 ; self-modifying code
   154  13fa 202d13             -   jsr read_line ; read left-side (40 columns) of vdc screen/attrs at line y
   155  13fd 20a613                 jsr write_line ; write to vic-ii screen/colors at line y
   156  1400 c8                     iny
   157  1401 c005               compare_line_count: cpy #$05 ; for 5 lines - self-modifying code
   158  1403 90f5                   bcc - ; repeat
   159  1405 8cdb15                 sty linenum
   160                          
   161                              ; retrive cursor position
   162  1408 a20e                   ldx #$0e ; cursor high position/offset
   163  140a 8e00d6                 stx vdc_register
   164  140d 2c00d6             -   bit vdc_register
   165  1410 10fb                   bpl -
   166  1412 ac01d6                 ldy vdc_value
   167  1415 e8                     inx ; cursor low position/offset
   168  1416 8e00d6                 stx vdc_register
   169  1419 2c00d6             -   bit vdc_register
   170  141c 10fb                   bpl -
   171  141e ad01d6                 lda vdc_value
   172                          
   173                          ; divide cursor position by 80 to get row/col
   174  1421 a200                   ldx #$00        ; initialize row 0
   175  1423 c000               -   cpy #$00
   176  1425 d004                   bne +           ; can subtract
   177  1427 c950                   cmp #$50
   178  1429 9009                   bcc divide_done ; cannot subtract
   179  142b e8                 +   inx
   180  142c e950                   sbc #$50        ; one row down
   181  142e b0f3                   bcs -           ; no borrow, repeat
   182  1430 88                     dey             ; borrow takes out of high byte
   183  1431 4c2314                 jmp -           ; repeat
   184                          divide_done:
   185  1434 8dd915                 sta col
   186  1437 8eda15                 stx row
   187                          
   188                          ; check if on hidden part of VDC screen
   189  143a c928                   cmp #40         ; on left?
   190                          exit_irq_halfway:   ; beq branch was too far, so branch again, bcs scenario covers eq as well
   191  143c b04b                   bcs exit_irq    ; cursor not on VIC side
   192  143e addb15                 lda linenum
   193  1441 38                     sec
   194  1442 edda15                 sbc row
   195  1445 c906                   cmp #$06
   196  1447 b040                   bcs exit_irq    ; cursor's line not drawn this cycle
   197                          
   198                          ; enforce background color
   199  1449 a21a                   ldx #26 ; fore/back color
   200  144b 8e00d6                 stx vdc_register
   201  144e 2c00d6             -   bit vdc_register
   202  1451 10fb                   bpl -
   203  1453 ad01d6                 lda vdc_value
   204  1456 290f                   and #15
   205  1458 a8                     tay
   206  1459 b9b515                 lda vdc_to_vicii_color,y
   207  145c 8d20d0                 sta $d020 ; VICII background (black)
   208  145f 8d21d0                 sta $d021 ; VICII border (black)
   209                          
   210                          ; one more check for cursor
   211  1462 a57f                   lda $7f ; BASIC run flag (0x80=running, 0x40=loading, 0=READY) // TODO: need INPUT flag to display cursor
   212  1464 d023                   bne exit_irq    ; do not display cursor when BASIC running
   213                          
   214                          ; inverse cursor on VIC-II screen to mirror hidden VDC cursor (off screen)
   215  1466 aeda15                 ldx row
   216  1469 bd6a15                 lda mult40high,x
   217  146c 18                     clc
   218  146d 6904                   adc #$04
   219  146f 8d8514                 sta fetch_reverse+2 ; self-modifying code
   220  1472 8d8814                 sta store_reverse+2 ; self-modifying code
   221  1475 bd5115                 lda mult40low,x
   222  1478 8d8414                 sta fetch_reverse+1 ; self-modifying code
   223  147b 8d8714                 sta store_reverse+1 ; self-modifying code
   224  147e acd915                 ldy col
   225  1481 a980                   lda #$80 ; reverse mask
   226                          fetch_reverse:
   227  1483 590004                 eor $0400,y ; fetch/reverse from screen memory (address self-modified)
   228                          store_reverse:
   229  1486 990004                 sta $0400,y ; store back to screen memory (address self-modified)
   230                          
   231                          exit_irq:
   232  1489 4c65fa                 jmp $fa65 ; rom irq handler (normally in $0314/5 vector)
   233                          
   234                          display_credit:
   235  148c 207dff                 jsr $FF7D ; kernal print embedded string, nul terminated, followed by more code
   236  148f 0d0d                       !byte $0d,$0d
   237  1491 38304455414c202d...        !text "80DUAL - EXTENDED C128 SCREENS",$0d
   238  14b0 434f505952494748...        !text "COPYRIGHT (C) 2026 DAVID VAN WAGNER     DAVEVW.COM  MIT LICENSE"
   239  14ef 00                         !byte 0
   240  14f0 60                     rts ; more code ... done
   241                          
